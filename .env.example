# Public client configuration. The anon/publishable key is safe to expose only with RLS enabled.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
BCARD_AUTO_RESEARCH=true
BCARD_RESEARCH_CACHE_DAYS=30
BCARD_MAX_IMAGE_BYTES=15728640

# Edge Function secrets: set with `supabase secrets set`; never expose in browser builds.
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
COMPANY_RESEARCH_MODEL=gpt-5-mini
RESEARCH_RATE_LIMIT_PER_HOUR=10
RESEARCH_CACHE_DAYS=30
